# Sanity CMS (rallya-docs)
# Copy to .env.local and fill in. .env.local is gitignored.
#
# Only the two tokens + webhook secret are required: the project id and
# dataset have committed defaults in sanity/lib/client.ts (they are not
# secrets — the embedded studio ships them to the browser by design).
# The env vars below exist as overrides for other deployments.

# Optional overrides (defaults: ejoyp5f4 / production)
# NEXT_PUBLIC_SANITY_PROJECT_ID=ejoyp5f4
# NEXT_PUBLIC_SANITY_DATASET=production

# API tokens (manage.sanity.io → API → Tokens)
# "rallya-docs-read" — read role; required because the dataset is private
SANITY_API_READ_TOKEN=
# "rallya-docs-write" — write role; used by `npm run migrate:docs` only
SANITY_API_WRITE_TOKEN=

# Secret used to verify Sanity webhook signatures (POST /api/sanity-revalidate)
SANITY_REVALIDATE_SECRET=

# Ask AI docs assistant (public, unauthenticated Mastra endpoint; browser calls it directly)
# Point to the deployed Mastra origin in production, e.g. https://<agent-host>/docs-chat
NEXT_PUBLIC_DOCS_CHAT_URL=http://localhost:4111/docs-chat
# Static resource id the anonymous docs assistant reports to Mastra Memory (shared across visitors)
NEXT_PUBLIC_DOCS_RESOURCE_ID=docs-visitor
