# Sanity CMS (rallya-docs)
# Copy to .env.local and fill in. .env.local is gitignored.

# Project "Rallya Docs" (org: rallya)
NEXT_PUBLIC_SANITY_PROJECT_ID=ejoyp5f4
NEXT_PUBLIC_SANITY_DATASET=production

# API tokens (manage.sanity.io → API → Tokens)
# "rallya-docs-read" — read role; required because the dataset is private
SANITY_API_READ_TOKEN=
# "rallya-docs-write" — write role; used by `npm run migrate:docs`
SANITY_API_WRITE_TOKEN=

# Secret used to verify Sanity webhook signatures (POST /api/sanity-revalidate)
SANITY_REVALIDATE_SECRET=
